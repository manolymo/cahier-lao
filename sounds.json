 "a67211297": {
  "text": "ເຈົ້າເດ",
  "f": "audio/f/a67211297.mp3"
 },
 "a3333e1eb": {
  "text": "ເຈົ້າແມ່ນຄົນປະເທດໃດ",
  "f": "audio/f/a3333e1eb.mp3"
 },
 "a1b291908": {
  "text": "ເທື່ອ",
  "f": "audio/f/a1b291908.mp3"
 },
 "a84b3bb0a": {
  "text": "ເປັນ",
  "f": "audio/f/a84b3bb0a.mp3"
 },
 "ad8cc75b3": {
  "text": "ເປັນເຈົ້າ ແຊບຫຼາຍ",
  "f": "audio/f/ad8cc75b3.mp3"
 },
 "a84b3bf46": {
  "text": "ເຜັດ",
  "f": "audio/f/a84b3bf46.mp3"
 },
 "a80a2996d": {
  "text": "ເຜັດບໍ",
  "f": "audio/f/a80a2996d.mp3"
 },
 "a9d906080": {
  "text": "ເວົ້າລາວ",
  "f": "audio/f/a9d906080.mp3"
 },
 "a1fe80b1c": {
  "text": "ເວົ້າລາວເກັ່ງເນາະ",
  "f": "audio/f/a1fe80b1c.mp3"
 },
 "a81da67ec": {
  "text": "ເອື້ອຍ",
  "f": "audio/f/a81da67ec.mp3"
 },
 "a2555f4f": {
  "text": "ເອື້ອຍເວົ້າລາວໄດ້ບໍ",
  "f": "audio/f/a2555f4f.mp3"
 },
 "a84b40d40": {
  "text": "ເຮົາ",
  "f": "audio/f/a84b40d40.mp3"
 },
 "abc7644a": {
  "text": "ແຊບ",
  "f": "audio/f/abc7644a.mp3"
 },
 "a1b338f71": {
  "text": "ແຊບບໍ",
  "f": "audio/f/a1b338f71.mp3"
 },
 "ab6602d50": {
  "text": "ແຊບຫຼາຍ",
  "f": "audio/f/ab6602d50.mp3"
 },
 "ad0f6ee5f": {
  "text": "ແຕ່ເຮົາເວົ້າພາສາອັງກິດໄດ້ເດີ",
  "f": "audio/f/ad0f6ee5f.mp3"
 },
 "abc76626": {
  "text": "ແທ້",
  "f": "audio/f/abc76626.mp3"
 },
 "ad65b9fa2": {
  "text": "ແມ່ ນີ້ແມ່ນໝູ່ຂອງຂ້ອຍ",
  "f": "audio/f/ad65b9fa2.mp3"
 },
 "ab996f499": {
  "text": "ແມ່ນແລ້ວ ຂ້ອຍມາແຕ່ປາຣີ",
  "f": "audio/f/ab996f499.mp3"
 },
 "a84b4751b": {
  "text": "ແລ້ວ",
  "f": "audio/f/a84b4751b.mp3"
 },
 "a83a81882": {
  "text": "ແລ້ວບໍ",
  "f": "audio/f/a83a81882.mp3"
 },
 "ae7eb8d86": {
  "text": "ໂອ້ຍ ຂໍໂທດ",
  "f": "audio/f/ae7eb8d86.mp3"
 },
 "a5b5ffc": {
  "text": "ໃດ",
  "f": "audio/f/a5b5ffc.mp3"
 },
 "a5b6012": {
  "text": "ໃສ",
  "f": "audio/f/a5b6012.mp3"
 },
 "abc77286": {
  "text": "ໄດ້",
  "f": "audio/f/abc77286.mp3"
 },
 "a9dad248d": {
  "text": "ໄດ້ບໍ ຂອບໃຈຫຼາຍໆ",
  "f": "audio/f/a9dad248d.mp3"
 },
 "a556f283b": {
  "text": "ໄດ້ໜ້ອຍໜຶ່ງ ພວກເຈົ້າເວົ້າພາສາຝຣັ່ງໄດ້ບໍ",
  "f": "audio/f/a556f283b.mp3"
 },
 "a9b10865c": {
  "text": "ໄປກ່ອນເດີ",
  "f": "audio/f/a9b10865c.mp3"
 },
 "a84c38b66": {
  "text": "ໜຶ່ງ",
  "f": "audio/f/a84c38b66.mp3"
 },
 "a84c3d8c4": {
  "text": "ໜ້ອຍ",
  "f": "audio/f/a84c3d8c4.mp3"
 },
 "a893116a5": {
  "text": "ໜ້ອຍໜຶ່ງ",
  "f": "audio/f/a893116a5.mp3"
 },
 "a9da39657": {
  "text": "ໜ້ອຍໜຶ່ງເຈົ້າ ຂອບໃຈ",
  "f": "audio/f/a9da39657.mp3"
 },
 "abc7e1a3": {
  "text": "ໝູ່",
  "f": "audio/f/abc7e1a3.mp3"
 }
}