  {
   "title": "Vocabulaire et blocs",
   "html": "<div class=\"tbl\"><table><tr><th>Lao</th><th>Romanisation</th><th>Sens</th><th>À retenir</th></tr><tr><td class=\"lo\">ອາກາດ</td><td class=\"rom\">Ǎa-kȁat</td><td>temps, climat</td><td></td></tr><tr><td class=\"lo\">ຝົນຕົກ</td><td class=\"rom\">Fǒn-tók</td><td>il pleut</td><td></td></tr><tr><td class=\"lo\">ຮ້ອນ</td><td class=\"rom\">Hȍɔn</td><td>chaud</td><td></td></tr><tr><td class=\"lo\">ໜາວ</td><td class=\"rom\">Nǎaw</td><td>froid</td><td></td></tr><tr><td class=\"lo\">ແດດ</td><td class=\"rom\">Dɛ̏ɛt</td><td>soleil (rayons)</td><td></td></tr><tr><td class=\"lo\">ລົມ</td><td class=\"rom\">Lóm</td><td>vent</td><td></td></tr><tr><td class=\"lo\">ລະດູຝົນ</td><td class=\"rom\">Lā-dǔu-fǒn</td><td>saison des pluies</td><td></td></tr><tr><td class=\"lo\">ລະດູແລ້ງ</td><td class=\"rom\">Lā-dǔu-lɛ̏ɛng</td><td>saison sèche</td><td></td></tr><tr><td class=\"lo\">ຄົງຈະ</td><td class=\"rom\">Khóng-já</td><td>sûrement</td><td></td></tr><tr><td class=\"lo\">ທັນວາ</td><td class=\"rom\">Thán-wáa</td><td>décembre</td><td></td></tr></table></div>"
