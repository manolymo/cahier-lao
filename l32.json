  {
   "title": "Vocabulaire et blocs",
   "html": "<div class=\"tbl\"><table><tr><th>Lao</th><th>Romanisation</th><th>Sens</th><th>À retenir</th></tr><tr><td class=\"lo\">ລົດຕຸກຕຸກ</td><td class=\"rom\">Lōt-tūk-tūk</td><td>tuk-tuk</td><td></td></tr><tr><td class=\"lo\">ລົດເມ</td><td class=\"rom\">Lōt-méé</td><td>bus</td><td></td></tr><tr><td class=\"lo\">ລົດຈັກ</td><td class=\"rom\">Lōt-ják</td><td>moto</td><td></td></tr><tr><td class=\"lo\">ຍົນ</td><td class=\"rom\">Nyón</td><td>avion</td><td></td></tr><tr><td class=\"lo\">ສະໜາມບິນ</td><td class=\"rom\">Sā-nǎam-bǐn</td><td>aéroport</td><td></td></tr><tr><td class=\"lo\">ຂຶ້ນ</td><td class=\"rom\">Khʉ̂n</td><td>monter</td><td></td></tr><tr><td class=\"lo\">ລົງ</td><td class=\"rom\">Lóng</td><td>descendre</td><td></td></tr><tr><td class=\"lo\">ຈອດ</td><td class=\"rom\">Jȍɔt</td><td>s&#x27;arrêter, se garer</td><td></td></tr><tr><td class=\"lo\">ຟ້າວ</td><td class=\"rom\">Fȁaw</td><td>être pressé</td><td></td></tr><tr><td class=\"lo\">ຂີ່</td><td class=\"rom\">Khìi</td><td>monter (à moto, à vélo)</td><td></td></tr></table></div>"
